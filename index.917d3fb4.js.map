var cells = Array.from(table.querySelectorAll("td"));
cells.forEach(function(cell) {
    cell.addEventListener("dblclick", function(ev) {
        var editCell = ev.currentTarget;
        var originText = editCell.textContent;
        if (cell === editCell) {
            var editInput = document.createElement("input");
            editInput.classList.add("cell-input");
            editInput.value = editCell.textContent;
            editCell.textContent = "";
            cell.appendChild(editInput);
            editInput.focus();
            var save = function() {
                var newValue = editInput.value.trim() === "" ? originText : editInput.value;
                cell.textContent = newValue;
                editInput.remove();
            };
            editInput.addEventListener("blur", save);
            editInput.addEventListener("keydown", function(e) {
                if (e.key === "Enter") editInput.blur();
            });
        }
    });
});

